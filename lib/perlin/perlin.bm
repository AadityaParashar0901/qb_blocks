' =========================================================
' FRACTAL BROWNIAN MOTION
' =========================================================

Function Fractal2! (x As Single, y As Single, s As Single, o As _Unsigned _Byte, m As _Unsigned _Byte) Static

    Static As Integer i
    Static As Single total, amplitude, frequency, maxValue, nx, ny

    total = 0: maxValue = 0
    amplitude = 1
    frequency = 1 / s

    nx = x + m * 1000: ny = y + m * 1000
    For i = 0 To o

        total = total + PerlinNoise2(nx * frequency, ny * frequency) * amplitude

        maxValue = maxValue + amplitude

        amplitude = amplitude * .5
        frequency = frequency * 2

    Next i

    Fractal2! = total / maxValue

End Function

Function Fractal3! (x As Single, y As Single, z As Single, s As Single, o As _Unsigned _Byte, m As _Unsigned _Byte) Static

    Static As Integer i
    Static As Single total, amplitude, frequency, maxValue, nx, ny, nz

    total = 0: maxValue = 0
    amplitude = 1
    frequency = 1 / s

    nx = x + m * 1000: ny = y + m * 1000: nz = z + m * 1000
    For i = 0 To o

        total = total + PerlinNoise3!(nx * frequency, ny * frequency, nz * frequency) * amplitude

        maxValue = maxValue + amplitude

        amplitude = amplitude * .5
        frequency = frequency * 2

    Next

    Fractal3! = total / maxValue

End Function

' =========================================================
' PERLIN NOISE
' =========================================================

Function PerlinNoise2! (x As Single, y As Single) Static

    Static As Integer X0, Y0
    Static As Integer X1, Y1

    Static As Single dx, dy
    Static As Single u, v

    Static As Integer A, B

    Static As Single g00, g10
    Static As Single g01, g11

    Static As Single ix0, ix1

    X0 = Int(x) And 255
    Y0 = Int(y) And 255

    X1 = (X0 + 1) And 255
    Y1 = (Y0 + 1) And 255

    dx = x - Int(x)
    dy = y - Int(y)

    ' Fade
    u = dx * dx * dx * (dx * (dx * 6 - 15) + 10)
    v = dy * dy * dy * (dy * (dy * 6 - 15) + 10)

    ' Cached lookups
    A = Perm(X0) + Y0
    B = Perm(X1) + Y0

    ' Gradients
    g00 = Grad2!(Perm(A), dx, dy)
    g10 = Grad2!(Perm(B), dx - 1, dy)

    g01 = Grad2!(Perm(A + 1), dx, dy - 1)
    g11 = Grad2!(Perm(B + 1), dx - 1, dy - 1)

    ' Interpolate X
    ix0 = g00 + u * (g10 - g00)
    ix1 = g01 + u * (g11 - g01)

    ' Interpolate Y
    PerlinNoise2! = ix0 + v * (ix1 - ix0)

End Function

Function PerlinNoise3! (x As Single, y As Single, z As Single) Static

    Static As Integer X0, Y0, Z0
    Static As Integer X1, Y1, Z1

    Static As Integer A, AA, AB
    Static As Integer B, BA, BB

    Static As Single dx, dy, dz
    Static As Single u, v, w

    Static As Single g000, g100, g010, g110
    Static As Single g001, g101, g011, g111

    Static As Single ix00, ix10
    Static As Single ix01, ix11
    Static As Single iy0, iy1

    X0 = Int(x) And 255
    Y0 = Int(y) And 255
    Z0 = Int(z) And 255

    X1 = (X0 + 1) And 255
    Y1 = (Y0 + 1) And 255
    Z1 = (Z0 + 1) And 255

    dx = x - Int(x)
    dy = y - Int(y)
    dz = z - Int(z)

    ' Inline fade
    u = dx * dx * dx * (dx * (dx * 6 - 15) + 10)
    v = dy * dy * dy * (dy * (dy * 6 - 15) + 10)
    w = dz * dz * dz * (dz * (dz * 6 - 15) + 10)

    ' Cached permutation lookups
    A = Perm(X0) + Y0
    AA = Perm(A) + Z0
    AB = Perm(A + 1) + Z0

    B = Perm(X1) + Y0
    BA = Perm(B) + Z0
    BB = Perm(B + 1) + Z0

    g000 = Grad3!(Perm(AA), dx, dy, dz)
    g100 = Grad3!(Perm(BA), dx - 1, dy, dz)

    g010 = Grad3!(Perm(AB), dx, dy - 1, dz)
    g110 = Grad3!(Perm(BB), dx - 1, dy - 1, dz)

    g001 = Grad3!(Perm(AA + 1), dx, dy, dz - 1)
    g101 = Grad3!(Perm(BA + 1), dx - 1, dy, dz - 1)

    g011 = Grad3!(Perm(AB + 1), dx, dy - 1, dz - 1)
    g111 = Grad3!(Perm(BB + 1), dx - 1, dy - 1, dz - 1)

    ' Inline lerps
    ix00 = g000 + u * (g100 - g000)
    ix10 = g010 + u * (g110 - g010)

    ix01 = g001 + u * (g101 - g001)
    ix11 = g011 + u * (g111 - g011)

    iy0 = ix00 + v * (ix10 - ix00)
    iy1 = ix01 + v * (ix11 - ix01)

    PerlinNoise3! = iy0 + w * (iy1 - iy0)

End Function

' =========================================================
' GRADIENT FUNCTION
' =========================================================

Function Grad2! (Hash As Integer, x As Single, y As Single) Static

    Select Case (Hash And 7)

        Case 0
            Grad2! = x + y

        Case 1
            Grad2! = -x + y

        Case 2
            Grad2! = x - y

        Case 3
            Grad2! = -x - y

        Case 4
            Grad2! = x

        Case 5
            Grad2! = -x

        Case 6
            Grad2! = y

        Case Else
            Grad2! = -y

    End Select

End Function

Function Grad3! (hash As Integer, x As Single, y As Single, z As Single) Static
    Static As Integer h
    Static As Single u, v, g
    h = hash And 15
    u = _IIf(h < 8, x, y)
    v = _IIf(h < 4, y, _IIf(h = 12 _OrElse h = 14, x, z))
    g = _IIf(h And 1, -u, u) + _IIf(h And 2, -v, v)
    Grad3! = g!
End Function

' =========================================================
' INITIALIZE PERMUTATION TABLE
' =========================================================

Sub InitPerlin (Seed As Long)

    Dim BasePerm(0 To 255) As Integer
    Dim As Integer i, j, t

    ' Fill sequentially
    For i = 0 To 255
        BasePerm(i) = i
    Next

    ' Seed RNG
    Randomize Seed

    ' Fisher-Yates shuffle
    For i = 255 To 1 Step -1

        j = Int(Rnd * (i + 1))

        t = BasePerm(i)
        BasePerm(i) = BasePerm(j)
        BasePerm(j) = t

    Next

    ' Duplicate table
    For i = 0 To 511
        Perm(i) = BasePerm(i And 255)
    Next

End Sub
