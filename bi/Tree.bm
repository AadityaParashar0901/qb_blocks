Function GenerateLSystem$ (Axiom$)
    Dim As String Current, NextStr
    Dim As Integer J
    Dim As String * 1 C
    Current = Axiom$
    For I = 1 To Len(Current)
        Asc(C, 1) = Asc(Current, I)
        Select Case C
            Case "F": NextStr = NextStr + "FF"
            Case "X": NextStr = NextStr + "[&[+FFF^^FFL][+++FFF^^FFL][-FFF^^FFL][---FFF^^FFL]]"
        End Select
    Next I
    GenerateLSystem$ = NextStr
End Function
Sub GenerateLTree (WX As Integer, WY As Integer, WZ As Integer)
    Dim As String S
    S = GenerateLSystem$("FFX")
    Dim As Integer SP
    Dim As TurtleState T
    T.X = WX
    T.Y = WY
    T.Z = WZ
    T.Pitch = 90
    Dim As Integer I
    For I = 1 To Len(S)
        C$ = Mid$(S, I, 1)
        Select Case C$
            Case "F"
                NX = T.X + Cos(_D2R(T.Yaw)) * Cos(_D2R(T.Pitch))
                NZ = T.Z + Sin(_D2R(T.Yaw)) * Cos(_D2R(T.Pitch))
                NY = T.Y + Sin(_D2R(T.Pitch))
                DrawVoxelLine Int(T.X), Int(T.Y), Int(T.Z), Int(NX), Int(NY), Int(NZ), getBlockID("oak_log")
                T.X = NX
                T.Y = NY
                T.Z = NZ
            Case "+"
                T.Yaw = T.Yaw + 45
            Case "-"
                T.Yaw = T.Yaw - 45
            Case "["
                Stack(SP) = T
                SP = SP + 1
            Case "]"
                SP = SP - 1
                T = Stack(SP)
            Case "&"
                T.Pitch = T.Pitch + 45
            Case "^"
                T.Pitch = T.Pitch - 45
            case "L"
                GenerateLeafBlob Int(T.X), Int(T.Y), Int(T.Z)
        End Select
    Next I
End Sub
Sub DrawVoxelLine (X1, Y1, Z1, X2, Y2, Z2, Block)
    DX = X2 - X1
    DY = Y2 - Y1
    DZ = Z2 - Z1
    Steps = Abs(DX)
    If Abs(DY) > Steps Then Steps = Abs(DY)
    If Abs(DZ) > Steps Then Steps = Abs(DZ)
    If Steps = 0 Then Exit Sub
    SX = DX / Steps
    SY = DY / Steps
    SZ = DZ / Steps
    X = X1
    Y = Y1
    Z = Z1
    For I = 0 To Steps
        setBlock Int(X), Int(Y), Int(Z), Block
        X = X + SX
        Y = Y + SY
        Z = Z + SZ
    Next
End Sub
Sub GenerateLeafBlob (X As Integer, Y As Integer, Z As Integer)
    For LX = -2 to 2
        For LY = -2 to 2
            For LZ = -2 to 2
                D = LX * LX + LY * LY + LZ * LZ
                If D > 4 Then _Continue
                If getBlock(X + LX, Y + LY, Z + LZ) = 0 Then setBlock X + LX, Y + LY, Z + LZ, getBlockID("oak_leaves")
            Next
        Next
    Next
End Sub
